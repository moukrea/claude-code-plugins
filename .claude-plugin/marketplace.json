      "version": "3.0.1",
      "author": {
        "name": "moukrea"
      },
      "homepage": "https://github.com/moukrea/claude-code-plugins",
      "repository": "https://github.com/moukrea/claude-code-plugins",
      "license": "MIT",
      "keywords": [
        "auth",
        "account",
        "switch",
        "profile",
        "credentials"
