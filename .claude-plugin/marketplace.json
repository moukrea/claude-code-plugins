  "plugins": [
    {
      "name": "opaq",
      "source": "./plugins/opaq",
      "description": "Secure credential manager and execution wrapper. Use secrets in commands without ever seeing them — for humans and AI agents alike.",
      "version": "0.2.1",
      "author": {
        "name": "moukrea"
      },
      "homepage": "https://github.com/moukrea/opaq",
